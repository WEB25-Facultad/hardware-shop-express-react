
    <main>
        <section class="categories-section" style="margin-top: 20px;">
            <div class="breadcrumb" style="margin-bottom: 30px;">
                <a href="/" style="color: var(--primary); text-decoration: none;">Inicio</a> > Categorías > <span style="text-transform: capitalize;"><%= categoryName %></span>
            </div>

            <h2 style="color: #00c8ff; margin-bottom: 40px; text-transform: capitalize;">Categoría: <%= categoryName %></h2>
        </section>

        <% if (products && products.length > 0) { %>
            <section class="productos-section">
                <div class="productos-container">
                    <% products.forEach(product => { %>
                        <a href="/products/<%= product.id %>" class="product-card" style="text-decoration: none;">
                            <div class="product-img-box" style="position: relative;">
                                <% if (product.stock === 0) { %>
                                    <span style="position: absolute; top: 10px; right: 10px; background-color: #ff4d6d; color: white; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; z-index: 2;">Sin stock</span>
                                <% } %>
                                <img src="<%= product.image || '/img/no-image.jpg' %>" alt="<%= product.name %>">
                            </div>
                            <div class="product-info">
                                <p class="price">$<%= product.price.toLocaleString() %></p>
                                <h4 class="name"><%= product.name %></h4>
                                <button class="boton-comprar">Ver Detalle</button>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </section>
        <% } else { %>
            <div style="text-align: center; margin-top: 50px; padding: 40px; background-color: var(--card-bg); border-radius: 10px; color: var(--text-muted);">
                <i class="fas fa-search" style="font-size: 3rem; margin-bottom: 15px; color: var(--primary);"></i>
                
                <% if (locals.isSearch) { %>
                    <h3>No se encontraron productos</h3>
                    <p>No hay coincidencias para la búsqueda "<strong><%= locals.searchQuery %></strong>". Intenta con otra palabra.</p>
                <% } else { %>
                    <h3>No hay productos en esta categoría</h3>
                    <p>Actualmente no contamos con productos disponibles para la categoría "<strong><span style="text-transform: capitalize;"><%= categoryName %></span></strong>".</p>
                <% } %>
                
                <a href="/" class="btn-primary" style="display: inline-block; margin-top: 20px; text-decoration: none;">Volver al Inicio</a>
            </div>
        <% } %>
    </main>

