<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Registro de Usuario</title>
        <link rel="stylesheet" href="/css/styles.css">
        <!-- Iconos de FontAwesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Outfit:wght@400;700;900&display=swap" rel="stylesheet">
    </head>
    <body>
        <main class="register-main">
            <div class="register-wrapper">
                <!-- Tarjeta contenedora del formulario de registro -->
                <section class="register-card">
                    <h2>¡Regístrate!</h2>
                    
                    <!-- Mensaje de error general si fallan las validaciones del servidor -->
                    <div id="form-global-error" class="global-error-msg <%= locals.error ? 'visible' : '' %>">
                        <%= locals.error || '' %>
                    </div>

                    <!-- Formulario de registro con validación local (novalidate se usa para validarlo por JS) -->
                    <form action="/register" method="POST" class="register-form" id="register-form" novalidate>
                            <!-- Input Nombre -->
                            <div class="control-formulario">
                                <label for="input-nombre">Nombre</label>
                                <input type="text" id="input-nombre" name="nombre" autocomplete="given-name">
                                <span class="field-error" id="error-nombre"></span>
                            </div>
                            
                            <!-- Input Apellido -->
                            <div class="control-formulario">
                                <label for="input-apellido">Apellido</label>
                                <input type="text" id="input-apellido" name="apellido" autocomplete="family-name">
                                <span class="field-error" id="error-apellido"></span>
                            </div>
                            
                            <!-- Input Email -->
                            <div class="control-formulario">
                                <label for="input-email">Email</label>
                                <input type="email" id="input-email" name="email" autocomplete="email">
                                <span class="field-error" id="error-email"></span>
                            </div>
                            
                            <!-- Input Contraseña -->
                            <div class="control-formulario">
                                <label for="input-password">Contraseña</label>
                                <div class="password-wrapper">
                                    <input type="password" id="input-password" name="password" autocomplete="new-password">
                                    <!-- Botón para alternar visibilidad de contraseña (ojo) -->
                                    <button type="button" class="toggle-password" data-target="input-password">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span class="field-error" id="error-password"></span>
                            </div>
                            
                            <!-- Input Repetir Contraseña -->
                            <div class="control-formulario">
                                <label for="input-password-repeat">Repetir Contraseña</label>
                                <div class="password-wrapper">
                                    <input type="password" id="input-password-repeat" name="password_repeat" autocomplete="new-password">
                                    <!-- Botón para alternar visibilidad de contraseña -->
                                    <button type="button" class="toggle-password" data-target="input-password-repeat">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span class="field-error" id="error-password-repeat"></span>
                            </div>
                            
                            <button type="submit" class="btn-register">Crear Cuenta</button>
                        </form>
                </section>

                <div class="register-footer-outside">
                    <!-- Enlace hacia la página de login -->
                    <p>¿Ya tienes cuenta? <a href="/login">Inicia Sesión</a></p>
                    
                    <!-- NUEVO: Enlace para volver directamente a la página principal desde la vista de registro -->
                    <p style="margin-top: 15px;">
                        <a href="/" style="color: #00c8ff; font-size: 0.9rem; text-decoration: none; font-weight: 600;">
                            <i class="fas fa-arrow-left" style="margin-right: 5px;"></i> Volver al Inicio
                        </a>
                    </p>
                </div>
            </div>
        </main>

        <!-- Script de JS en frontend que realiza las validaciones en tiempo real -->
        <script src="/controllers/register.js" defer></script>
    </body>
</html>
