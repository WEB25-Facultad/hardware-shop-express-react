<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<header class="main-header">
    <div class="header-top">
        <button class="menu-toggle" id="mobile-menu-btn">
            <i class="fas fa-bars"></i>
        </button>

        <h1 class="logo">HARDWARE<span>STORE</span></h1>
        
        <div class="search-bar">
            <input type="text" placeholder="Buscar componentes..." class="input-search">
            <button class="btn-search">🔍</button>
        </div>

        <div class="user-nav desktop-only">
            <a href="/cart" class="cart-container" style="color: white; text-decoration: none;">
                <i class="fas fa-shopping-cart"></i>
                <span class="badge">3</span>
            </a>
            <div class="user-profile">
                <img src="https://i.imgur.com/8Km9tLL.png" alt="Avatar" class="avatar">
                <span>Gamer_JoniOliva</span>
            </div>
        </div>

        <div class="mobile-cart-icon mobile-only">
            <a href="/cart" class="cart-container" style="color: white; text-decoration: none;">
                <i class="fas fa-shopping-cart"></i>
                <span class="badge">3</span>
            </a>
        </div>
    </div>
    
    <nav class="main-nav desktop-nav">
        <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/login">Iniciar sesión</a></li>
            <li><a href="/register">Registrar</a></li>
            <li><a href="/cart">Carrito</a></li>
        </ul>
    </nav>
</header>

<!-- Menú lateral móvil -->
<div class="mobile-drawer" id="mobileDrawer">
    <div class="drawer-header">
        <div class="user-profile-mobile">
            <img src="https://i.imgur.com/8Km9tLL.png" alt="Avatar" class="avatar-large">
            <span>Gamer_JoniOliva</span>
        </div>
        <button class="btn-close-drawer" id="closeDrawerBtn"><i class="fas fa-times"></i></button>
    </div>
    <ul class="drawer-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/login">Iniciar sesión</a></li>
        <li><a href="/register">Registrar</a></li>
        <li><a href="/cart">Carrito</a></li>
        <hr>
        <li><a href="#">Mis Compras</a></li>
        <li><a href="#">Favoritos</a></li>
        <li><a href="#">Historial</a></li>
        <li><a href="#">Cambiar a Tema Oscuro</a></li>
    </ul>
</div>
<div class="drawer-overlay" id="drawerOverlay"></div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btnOpen = document.getElementById('mobile-menu-btn');
        const btnClose = document.getElementById('closeDrawerBtn');
        const drawer = document.getElementById('mobileDrawer');
        const overlay = document.getElementById('drawerOverlay');

        if(btnOpen && drawer) {
            const toggleMenu = () => {
                drawer.classList.toggle('open');
                overlay.classList.toggle('open');
            };

            btnOpen.addEventListener('click', toggleMenu);
            btnClose.addEventListener('click', toggleMenu);
            overlay.addEventListener('click', toggleMenu);
        }
    });
</script>