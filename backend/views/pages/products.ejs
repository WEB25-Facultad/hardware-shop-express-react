<main>
    <section class="productos-section">
        <h2 style="text-align: center; margin: 40px 0; color: #00c8ff;">Nuestro Catálogo</h2>
        
        <!-- Controles para ordenar la lista de productos por precio -->
        <div class="sorting-controls" style="text-align: center; margin-bottom: 30px;">
            <span style="color: white; margin-right: 15px;">Ordenar por precio:</span>
            <a href="/products" style="color: white; text-decoration: none; padding: 8px 15px; background: #222; border: 1px solid #00c8ff; border-radius: 5px; margin-right: 10px; font-weight: 600;">Destacados</a>
            <a href="/products?sort=asc" style="color: white; text-decoration: none; padding: 8px 15px; background: #222; border: 1px solid #00c8ff; border-radius: 5px; margin-right: 10px; font-weight: 600;"><i class="fas fa-sort-amount-up" style="margin-right: 5px;"></i>Menor a Mayor</a>
            <a href="/products?sort=desc" style="color: white; text-decoration: none; padding: 8px 15px; background: #222; border: 1px solid #00c8ff; border-radius: 5px; font-weight: 600;"><i class="fas fa-sort-amount-down" style="margin-right: 5px;"></i>Mayor a Menor</a>
        </div>

        <div class="productos-container">
            <!-- 
              Iteramos sobre los productos del catálogo y los renderizamos mediante 'productCard'
              para evitar duplicación de lógica en la maquetación.
            -->
            <% products.forEach(product => { %>
                <%- include('../partials/productCard', { product: product }) %>
            <% }) %>
        </div>
    </section>
</main>
