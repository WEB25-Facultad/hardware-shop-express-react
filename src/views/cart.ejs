<!DOCTYPE html>
<html lang="es">
<%- include('./partials/header') %>

    <body>
        <main class="cart-main">
            <div class="cart-container-page">
                <div class="cart-header-actions">
                    <a href="/" class="btn-back">← Volver al listado</a>
                </div>

                <h2 class="cart-title">Tu Carrito de Compras</h2>

                <% if (cartProducts && cartProducts.length> 0) { %>
                    <div class="cart-grid">
                        <div class="cart-items-column">
                            <div class="cart-items">
                                <% cartProducts.forEach(item=> { %>
                                    <article class="cart-item">
                                        <div class="item-main-info">
                                            <img src="<%= item.image %>" alt="<%= item.name %>">
                                            <div class="cart-item-name">
                                                <h4>
                                                    <%= item.name %>
                                                </h4>
                                                <p style="font-size: 0.8rem; color: #888;">Cod: #00<%= item.id %>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="cart-item-actions">
                                            <div class="quantity-control">
                                                <form action="/cart/decrease/<%= item.id %>" method="POST">
                                                    <button type="submit" class="btn-qty btn-minus"><i
                                                            class="fas fa-minus"></i></button>
                                                </form>
                                                <span class="quantity">
                                                    <%= item.quantity %>
                                                </span>
                                                <form action="/cart/increase/<%= item.id %>" method="POST">
                                                    <button type="submit" class="btn-qty btn-plus"><i
                                                            class="fas fa-plus"></i></button>
                                                </form>
                                            </div>
                                            <div class="cart-item-price">
                                                <span class="points">$<%= item.subtotal.toLocaleString() %></span>
                                            </div>
                                            <form action="/cart/remove/<%= item.id %>" method="POST">
                                                <button type="submit" class="btn-remove" title="Quitar producto"><i
                                                        class="fas fa-trash-alt"></i></button>
                                            </form>
                                        </div>
                                    </article>
                                    <% }) %>
                            </div>
                            <div class="cart-footer-actions">
                                <form action="/cart/clear" method="POST">
                                    <button type="submit" class="btn-vaciar">Vaciar Carrito</button>
                                </form>
                            </div>
                        </div>

                        <aside class="cart-summary-premium">
                            <h3 class="summary-title">Resumen de Compra</h3>
                            <div class="summary-row">
                                <span>Productos (<%= cartCount %>)</span>
                                <span>$<%= total.toLocaleString() %></span>
                            </div>
                            <div class="summary-row">
                                <span>Envío</span>
                                <span style="color: #00e676;">Gratis</span>
                            </div>
                            <div class="summary-row total">
                                <span>Total</span>
                                <span>$<%= total.toLocaleString() %></span>
                            </div>

                            <a href="/checkout" class="btn-checkout"
                                style="width: 100%; text-align: center; margin-top: 20px;">Continuar Compra</a>
                        </aside>
                    </div>
                    <% } else { %>
                        <div class="empty-cart-message">
                            <i class="fas fa-shopping-basket"
                                style="font-size: 4rem; color: #333; margin-bottom: 20px;"></i>
                            <p>Parece que aún no has agregado nada.</p>
                            <a href="/" class="btn-checkout" style="font-size: 1rem; padding: 10px 30px;">Explorar
                                Productos</a>
                        </div>
                        <% } %>
            </div>
        </main>
        <%- include('./partials/footer') %>
    </body>

</html>