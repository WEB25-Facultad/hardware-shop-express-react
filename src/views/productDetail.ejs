<!DOCTYPE html>
<html lang="es">
<%- include('./partials/header') %>
<body>
    <main class="product-detail-main">
        <div class="breadcrumb">
            <a href="/">Inicio</a> > <a href="/products">Productos</a> > <%= product.name %>
        </div>

        <section class="detail-card">
            <div class="gallery-column">
                <div class="thumbnails">
                    <img src="<%= product.image %>" alt="Thumb 1" class="thumb-image active">
                    <img src="<%= product.image %>" alt="Thumb 2" class="thumb-image">
                    <img src="<%= product.image %>" alt="Thumb 3" class="thumb-image">
                </div>
                <div class="main-image-container">
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                </div>
            </div>

            <div class="info-column">
                <h2><%= product.name %></h2>
                <div class="product-price">$<%= product.price.toLocaleString() %></div>
                <form action="/cart/add/<%= product.id %>" method="POST">
                    <button type="submit" class="btn-add-cart">Agregar al Carrito</button>
                </form>
                
                <div class="product-description">
                    <p><%= product.description %></p>
                    <p>Ideal para tareas pesadas, creación de contenido y los juegos más exigentes del mercado.</p>
                </div>
            </div>
        </section>

        <!-- PRODUCTOS RELACIONADOS -->
        <% if (locals.related && related.length > 0) { %>
            <h3 class="related-title">También te puede interesar</h3>
            <section class="productos-container" style="margin-bottom: 50px;">
                <% related.forEach(relatedProduct => { %>
                    <article class="product-card">
                        <a href="/products/<%= relatedProduct.id %>" style="text-decoration: none; color: inherit;">
                            <div class="product-img-box">
                                <img src="<%= relatedProduct.image %>" alt="<%= relatedProduct.name %>">
                            </div>
                            <div class="product-info">
                                <p class="price">$<%= relatedProduct.price.toLocaleString() %></p>
                                <h4 class="name"><%= relatedProduct.name %></h4>
                                <button class="boton-comprar">Ver Detalle</button>
                            </div>
                        </a>
                    </article>
                <% }) %>
            </section>
        <% } %>
    </main>
    <!-- MODAL DE CONFIRMACIÓN -->
    <div id="addModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <i class="fas fa-check-circle" style="color: #00e676; font-size: 3rem; margin-bottom: 15px;"></i>
                <h3>¡Producto Agregado!</h3>
                <p>El producto <strong><%= product.name %></strong> se añadió a tu carrito.</p>
            </div>
            <div class="modal-actions">
                <button onclick="closeModal()" class="btn-secondary">Seguir Comprando</button>
                <a href="/cart" class="btn-primary">Ver Carrito</a>
            </div>
        </div>
    </div>

    <script>
        function closeModal() {
            document.getElementById('addModal').style.display = 'none';
            // Limpiar la URL sin recargar la página
            const url = new URL(window.location);
            url.searchParams.delete('added');
            window.history.replaceState({}, '', url);
        }

        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('added') === 'true') {
                document.getElementById('addModal').style.display = 'flex';
            }
        });
    </script>
    <%- include('./partials/footer') %>
</body>
</html>