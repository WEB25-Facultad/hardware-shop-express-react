<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Login</title>
        <link rel="stylesheet" href="/css/styles.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Outfit:wght@400;700;900&display=swap" rel="stylesheet">
    </head>
    <body>
        <main class="register-main">
            <div class="register-wrapper">
                <section class="register-card">
                    <h2>¡Hola!</h2>
                    <form action="/" method="GET" class="register-form">
                        <div class="control-formulario">
                            <input type="text" name="user" placeholder="Tu nombre de usuario" required>
                        </div>
                        <div class="control-formulario">
                            <input type="password" name="password" placeholder="Tu contraseña" required>
                        </div>
                        <button type="button" class="btn-register" onclick="window.location.href='/'">Iniciar Sesión</button>
                    </form>
                </section>

                <div class="register-footer-outside">
                    <p>¿No tienes cuenta? <a href="/register">Registrar</a></p>
                </div>
            </div>
        </main>

    </body>

</html>