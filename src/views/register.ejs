<!DOCTYPE html>
<html lang="es">
<%- include('./partials/header') %>

    <body>
        <main class="register-main">
            <div class="register-wrapper">
                <section class="register-card">
                    <h2>¡Regístrate!</h2>
                    <form action="/" method="GET" class="register-form">
                        <div class="control-formulario">
                            <input type="email" name="email" placeholder="Tu email" required>
                        </div>
                        <div class="control-formulario">
                            <input type="password" name="password" placeholder="Tu nueva contraseña" required>
                        </div>
                        <div class="control-formulario">
                            <input type="password" name="password_repeat" placeholder="Repite tu contraseña" required>
                        </div>
                        <button type="submit" class="btn-register">Crear Cuenta</button>
                    </form>
                </section>
                <div class="register-footer-outside">
                    <p>¿Ya tienes cuenta? <a href="/login">Inicia Sesión</a></p>
                </div>
            </div>
        </main>
        <%- include('./partials/footer') %>
    </body>

</html>