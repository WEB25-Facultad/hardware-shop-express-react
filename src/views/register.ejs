<!DOCTYPE html>
<html lang="es">
<%- include('./partials/header') %>

    <body>
        <main class="register-main">
            <div class="register-wrapper">
                <section class="register-card">
                    <h2>¡Regístrate!</h2>
                    <div id="form-global-error" class="global-error-msg"></div>
                    <%# action queda en "/" (GET) hasta que se implemente el backend de registro %>
                        <form action="/" method="GET" class="register-form" id="register-form" novalidate>
                            <div class="control-formulario">
                                <label for="input-nombre">Nombre</label>
                                <input type="text" id="input-nombre" name="nombre"
                                    autocomplete="given-name">
                                <span class="field-error" id="error-nombre"></span>
                            </div>
                            <div class="control-formulario">
                                <label for="input-apellido">Apellido</label>
                                <input type="text" id="input-apellido" name="apellido"
                                    autocomplete="family-name">
                                <span class="field-error" id="error-apellido"></span>
                            </div>
                            <div class="control-formulario">
                                <label for="input-email">Email</label>
                                <input type="email" id="input-email" name="email"
                                    autocomplete="email">
                                <span class="field-error" id="error-email"></span>
                            </div>
                            <div class="control-formulario">
                                <label for="input-password">Contraseña</label>
                                <div class="password-wrapper">
                                    <input type="password" id="input-password" name="password"
                                        autocomplete="new-password">
                                    <button type="button" class="toggle-password" data-target="input-password">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span class="field-error" id="error-password"></span>
                            </div>
                            <div class="control-formulario">
                                <label for="input-password-repeat">Repetir Contraseña</label>
                                <div class="password-wrapper">
                                    <input type="password" id="input-password-repeat" name="password_repeat"
                                        autocomplete="new-password">
                                    <button type="button" class="toggle-password" data-target="input-password-repeat">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span class="field-error" id="error-password-repeat"></span>
                            </div>
                            <button type="submit" class="btn-register">Crear Cuenta</button>
                        </form>
                </section>
                <div class="register-footer-outside">
                    <p>¿Ya tienes cuenta? <a href="/login">Inicia Sesión</a></p>
                </div>
            </div>
        </main>
        <%- include('./partials/footer') %>
        <script src="/controllers/register.js" defer></script>
    </body>

</html>