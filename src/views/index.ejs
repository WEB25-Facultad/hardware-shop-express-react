<!DOCTYPE html>
<html lang="es">
<%- include('./partials/header') %>

    <body>
        <main>
            <!-- SECCIÓN PRODUCT HERO (Beneficios arriba) -->
            <section class="hero-section">
                <article class="product-hero"
                    style="background-image: url('/img/windows_banner.jpg');">
                    <div class="hero-content">
                        <h3>Sistemas Operativos</h3>
                        <p>30% de descuento en licencias Windows</p>
                    </div>
                </article>
                <article class="product-hero"
                    style="background-image: url('/img/steam.jpg');">
                    <div class="hero-content">
                        <h3>Bonus Gaming</h3>
                        <p>Gift Card Steam $50 USD en compras superiores a $500.000</p>
                    </div>
                </article>
            </section>

            <!-- SECCIÓN CATEGORÍAS (Debajo de beneficios) -->
            <section class="categories-section">
                <div class="categories-grid">
                    <article class="category-item">
                        <i class="fas fa-microchip"></i>
                        <span>Procesadores</span>
                    </article>
                    <article class="category-item">
                        <i class="fas fa-desktop"></i>
                        <span>Monitores</span>
                    </article>
                    <article class="category-item">
                        <i class="fas fa-memory"></i>
                        <span>Memorias RAM</span>
                    </article>
                    <article class="category-item">
                        <i class="fas fa-laptop"></i>
                        <span>Notebooks</span>
                    </article>
                    <article class="category-item">
                        <i class="fas fa-hdd"></i>
                        <span>Almacenamiento</span>
                    </article>
                    <article class="category-item">
                        <i class="fas fa-plug"></i>
                        <span>Fuentes</span>
                    </article>
                    <article class="category-item">
                        <i class="fas fa-keyboard"></i>
                        <span>Periféricos</span>
                    </article>
                    <article class="category-item">
                        <i class="fas fa-video"></i>
                        <span>Placas de Video</span>
                    </article>
                </div>
            </section>

            <!-- LISTADO DE PRODUCTOS -->
            <section class="productos-section">
                <h2 style="text-align: center; margin: 40px 0; color: #00c8ff;">Te puede interesar</h2>
                <div class="productos-container">
                    <% products.forEach(product => { %>
                        <a href="/products/<%= product.id %>" class="product-card" style="text-decoration: none;">
                            <div class="product-img-box">
                                <img src="<%= product.image %>" alt="<%= product.name %>">
                            </div>
                            <div class="product-info">
                                <p class="price">$<%= product.price.toLocaleString() %></p>
                                <h4 class="name"><%= product.name %></h4>
                                <button class="boton-comprar">Ver Detalle</button>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </section>
        </main>

        <%- include('./partials/footer') %>
    </body>

</html>