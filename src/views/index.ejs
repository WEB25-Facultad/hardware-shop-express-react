<!DOCTYPE html>
<html lang="es">
<%- include('./partials/header') %>

    <body>
        <main>
            <!-- SECCIÓN PRODUCT HERO (Beneficios arriba) -->
            <section class="hero-section">
                <article class="product-hero"
                    style="background-image: url('/img/windows_banner.jpg');">
                    <div class="hero-content">
                        <h3>Sistemas Operativos</h3>
                        <p>30% de descuento en licencias Windows</p>
                    </div>
                </article>
                <article class="product-hero"
                    style="background-image: url('/img/steam.jpg');">
                    <div class="hero-content">
                        <h3>Bonus Gaming</h3>
                        <p>Gift Card Steam $50 USD en compras superiores a $500.000</p>
                    </div>
                </article>
            </section>

            <!-- SECCIÓN CATEGORÍAS (Debajo de beneficios) -->
            <section class="categories-section">
                <div class="categories-grid">
                    <a href="/categories/Procesadores" class="category-item" style="text-decoration: none; color: inherit;">
                        <i class="fas fa-microchip"></i>
                        <span>Procesadores</span>
                    </a>
                    <a href="/categories/Monitores" class="category-item" style="text-decoration: none; color: inherit;">
                        <i class="fas fa-desktop"></i>
                        <span>Monitores</span>
                    </a>
                    <a href="/categories/Memorias RAM" class="category-item" style="text-decoration: none; color: inherit;">
                        <i class="fas fa-memory"></i>
                        <span>Memorias RAM</span>
                    </a>
                    <a href="/categories/Notebooks" class="category-item" style="text-decoration: none; color: inherit;">
                        <i class="fas fa-laptop"></i>
                        <span>Notebooks</span>
                    </a>
                    <a href="/categories/Almacenamiento" class="category-item" style="text-decoration: none; color: inherit;">
                        <i class="fas fa-hdd"></i>
                        <span>Almacenamiento</span>
                    </a>
                    <a href="/categories/Fuentes" class="category-item" style="text-decoration: none; color: inherit;">
                        <i class="fas fa-plug"></i>
                        <span>Fuentes</span>
                    </a>
                    <a href="/categories/Perifericos" class="category-item" style="text-decoration: none; color: inherit;">
                        <i class="fas fa-keyboard"></i>
                        <span>Periféricos</span>
                    </a>
                    <a href="/categories/Placas de Video" class="category-item" style="text-decoration: none; color: inherit;">
                        <i class="fas fa-video"></i>
                        <span>Placas de Video</span>
                    </a>
                </div>
            </section>

            <!-- LOS MÁS PEDIDOS -->
            <section class="productos-section">
                <h2 style="text-align: center; margin: 40px 0; color: #00c8ff;">Los más pedidos</h2>
                <div class="productos-container">
                    <% mostRequested.forEach(product => { %>
                        <a href="/products/<%= product.id %>" class="product-card" style="text-decoration: none;">
                            <div class="product-img-box" style="position: relative;">
                                <% if (product.stock === 0) { %>
                                    <span style="position: absolute; top: 10px; right: 10px; background-color: #ff4d6d; color: white; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; z-index: 2;">Sin stock</span>
                                <% } %>
                                <img src="<%= product.image || '/img/no-image.jpg' %>" alt="<%= product.name %>">
                            </div>
                            <div class="product-info">
                                <p class="price">$<%= product.price.toLocaleString() %></p>
                                <h4 class="name"><%= product.name %></h4>
                                <button class="boton-comprar">Ver Detalle</button>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </section>

            <!-- TE PUEDE INTERESAR -->
            <section class="productos-section">
                <h2 style="text-align: center; margin: 40px 0; color: #00c8ff;">Te puede interesar</h2>
                <div class="productos-container">
                    <% products.forEach(product => { %>
                        <a href="/products/<%= product.id %>" class="product-card" style="text-decoration: none;">
                            <div class="product-img-box" style="position: relative;">
                                <% if (product.stock === 0) { %>
                                    <span style="position: absolute; top: 10px; right: 10px; background-color: #ff4d6d; color: white; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; z-index: 2;">Sin stock</span>
                                <% } %>
                                <img src="<%= product.image || '/img/no-image.jpg' %>" alt="<%= product.name %>">
                            </div>
                            <div class="product-info">
                                <p class="price">$<%= product.price.toLocaleString() %></p>
                                <h4 class="name"><%= product.name %></h4>
                                <button class="boton-comprar">Ver Detalle</button>
                            </div>
                        </a>
                    <% }) %>
                </div>
            </section>
        </main>

        <%- include('./partials/footer') %>
    </body>

</html>